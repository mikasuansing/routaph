{
  "name": "parapo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:migrations": "node scripts/check-migrations.mjs",
    "env:check": "node scripts/env-check.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm audit --omit=dev --audit-level=high && npm run check:migrations"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@supabase/supabase-js": "^2.112.2",
    "@types/leaflet": "^1.9.22",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.30.0",
    "maplibre-gl": "^6.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.10.1",
    "zod": "^4.4.3"
  },
  "//overrides": "postcss and sharp ship inside Next's own dependency tree, so npm's only offered 'fix' is downgrading Next to v9 — a breaking change, not a fix. Pinning the patched releases here resolves the advisories without touching the framework version.",
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.6"
  }
}
